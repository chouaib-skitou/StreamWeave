{
  "title": "StreamWeave Orders Overview",
  "uid": "streamweave-orders-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "type": "stat", "title": "Request rate", "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 }, "targets": [{ "expr": "sum(rate(orders_http_requests_total[5m]))", "refId": "A" }] },
    { "type": "stat", "title": "5xx rate", "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 }, "targets": [{ "expr": "sum(rate(orders_http_requests_total{status=~\"5..\"}[5m]))", "refId": "A" }] },
    { "type": "stat", "title": "In-flight requests", "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 }, "targets": [{ "expr": "orders_http_in_flight_requests", "refId": "A" }] },
    { "type": "timeseries", "title": "HTTP requests by status", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 }, "targets": [{ "expr": "sum by (status) (rate(orders_http_requests_total[5m]))", "legendFormat": "{{status}}", "refId": "A" }] },
    { "type": "timeseries", "title": "Request latency p95", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(orders_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" }] },
    { "type": "timeseries", "title": "Requests by route", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 }, "targets": [{ "expr": "sum by (route, method) (rate(orders_http_requests_total[5m]))", "legendFormat": "{{method}} {{route}}", "refId": "A" }] }
  ]
}
