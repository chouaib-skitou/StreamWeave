# Copy to .env for local Compose only. Never commit the copy.
IDENTITY_DB_PASSWORD=replace-with-a-local-password

# Local manual testing: tokens are held in memory and exposed only by the
# local-only /_test/mailbox/latest endpoint.
IDENTITY_MAILER_MODE=simulated
IDENTITY_TEST_MAILER_ENABLED=true

# Production/SMTP example (do not use simulated mode in production).
# IDENTITY_SMTP_HOST=smtp.example.com
# IDENTITY_SMTP_PORT=587
# IDENTITY_SMTP_USERNAME=replace-with-secret
# IDENTITY_SMTP_PASSWORD=replace-with-secret
# IDENTITY_SMTP_FROM=identity@example.com
