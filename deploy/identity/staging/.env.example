# Mailtrap Email Sandbox credentials. Copy to .env locally; never commit it.
IDENTITY_SMTP_USERNAME=replace-with-mailtrap-sandbox-username
IDENTITY_SMTP_PASSWORD=replace-with-mailtrap-sandbox-password
IDENTITY_SMTP_HOST=sandbox.smtp.mailtrap.io
IDENTITY_SMTP_PORT=2525
IDENTITY_SMTP_FROM=identity-staging@example.test
