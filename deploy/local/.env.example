# Shared local platform stack. Copy to deploy/local/.env; never commit the copy.
IDENTITY_DB_PASSWORD=replace-with-a-local-password
IDENTITY_GRAFANA_ADMIN_USER=admin
IDENTITY_GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password
GATEWAY_SERVICE_TOKEN=replace-with-a-development-service-token
GATEWAY_ORDERS_URL=http://host.docker.internal:8082
GATEWAY_CORS_ORIGINS=http://localhost:3000
