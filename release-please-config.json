{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "separate-pull-requests": false,
  "packages": {
    ".": {
      "package-name": "event-driven-ecommerce-platform",
      "version-file": "VERSION",
      "changelog-path": "CHANGELOG.md"
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "security", "section": "Security" },
    { "type": "docs", "section": "Documentation", "hidden": false },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Maintenance", "hidden": true }
  ],
  "pull-request-title-pattern": "chore(release): Prepare ${version}",
  "pull-request-header": "This release pull request was generated from reviewed Conventional Commits.",
  "pull-request-footer": "After merge, Release Please publishes the VERSION, CHANGELOG.md, tag, and GitHub Release."
}
