{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.streamweave.dev/commerce/payment/refunded.v1.json",
  "title": "PaymentRefunded v1",
  "allOf": [ { "$ref": "https://schemas.streamweave.dev/commerce/event-envelope.v1.json" }, { "properties": { "event_type": { "const": "commerce.payment.refunded.v1" }, "aggregate_type": { "const": "payment" }, "producer": { "const": "payments" }, "data": { "type": "object", "required": ["order_id", "payment_id", "amount_minor", "currency"], "properties": { "order_id": { "type": "string", "pattern": "^ord_[A-Za-z0-9]+$" }, "payment_id": { "type": "string", "pattern": "^pay_[A-Za-z0-9]+$" }, "amount_minor": { "type": "integer", "minimum": 0 }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" } }, "additionalProperties": false } } } ]
}
