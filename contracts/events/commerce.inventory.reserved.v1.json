{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.streamweave.dev/commerce/inventory/events/reserved.v1.json",
  "title": "InventoryReserved event v1",
  "allOf": [
    { "$ref": "https://schemas.streamweave.dev/commerce/event-envelope.v1.json" },
    {
      "properties": {
        "event_type": { "const": "commerce.inventory.reserved.v1" },
        "aggregate_type": { "const": "inventory" },
        "producer": { "const": "inventory" },
        "data": {
          "type": "object",
          "required": ["order_id", "reservation_id", "quote_id", "quote_version", "quote_key_id", "quote_expires_at", "quote_signature", "currency", "items"],
          "properties": {
            "order_id": { "type": "string", "pattern": "^ord_[A-Za-z0-9]+$" },
            "reservation_id": { "type": "string", "pattern": "^res_[A-Za-z0-9]+$" },
            "quote_id": { "type": "string", "pattern": "^qte_[A-Za-z0-9]+$" },
            "quote_version": { "type": "integer", "minimum": 1 },
            "quote_key_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
            "quote_expires_at": { "type": "string", "format": "date-time" },
            "quote_signature": { "type": "string", "minLength": 16, "maxLength": 4096 },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["product_id", "quantity", "unit_price_minor", "line_total_minor"],
                "properties": {
                  "product_id": { "type": "string", "pattern": "^prd_[A-Za-z0-9]+$" },
                  "quantity": { "type": "integer", "minimum": 1 },
                  "unit_price_minor": { "type": "integer", "minimum": 0 },
                  "line_total_minor": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
